<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 頂部拖曳把手 -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="匯入小說 (GitHub 網址或本機檔案)"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="不寫死任何內容，可直接貼上 GitHub 專案目錄網址或單一章節網址，自動抓取並建立索引朗讀。"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <!-- 網址輸入框 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGithubUrl"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:endIconMode="clear_text"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGithubUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="貼上 GitHub 網址 (tree 目錄或 blob 章節)..."
                android:textSize="13sp"
                android:maxLines="3"
                android:inputType="textUri" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 貼上按鈕與快速範例 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="範例捷徑："
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPasteClipboard"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="貼上剪貼簿"
                android:textSize="12sp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconSize="14dp" />

        </LinearLayout>

        <!-- 範例 Chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupExamples"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipExampleYuanTree"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="元末明初全本 (/yuan)"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipExampleYuanChap1"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="元末第1章 (chap001.md)"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipExampleGuixu"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="歸墟 Online (/guixu)"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipExampleFormosa"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Origins-of-Formosa"
                android:textSize="12sp" />

        </com.google.android.material.chip.ChipGroup>

        <!-- 載入按鈕 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadAndRead"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="從 GitHub 下載並開始朗讀"
            android:backgroundTint="@color/primary"
            android:textColor="@android:color/white"
            app:cornerRadius="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider" />

        <!-- 本機上傳與開啟選項 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="或從本機上傳 / 開啟："
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadArchive"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="上傳 ZIP / TAR"
                android:textSize="12sp"
                app:icon="@android:drawable/stat_sys_download"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectDirectory"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="選取本機目錄"
                android:textSize="12sp"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconSize="16dp" />

        </LinearLayout>

        <!-- 下載進度提示 (預設隱藏) -->
        <LinearLayout
            android:id="@+id/layoutProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/tvProgressMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="正在連線下載中..."
                android:textColor="@color/primary"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
