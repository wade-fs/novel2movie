<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 頂部拖曳把手 -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 快速模式選擇 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="朗讀預設模式"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPresetModes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipModeFull"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_full" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipModeBodyOnly"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_body_only" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipModeTitleAndBody"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_title_and_body" />

        </com.google.android.material.chip.ChipGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider" />

        <!-- 語速設定 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/speed"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSpeedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.00x"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.5"
            android:valueTo="2.5"
            android:stepSize="0.05"
            android:value="1.0"
            app:thumbColor="@color/primary"
            app:trackColorActive="@color/primary" />

        <!-- 語速快速按鈕 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeed075"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="0.75x"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeed100"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="1.0x"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeed125"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="1.25x"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeed150"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="1.5x"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeed200"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="2.0x"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider" />

        <!-- 語音與語調 (男生/女生) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="語音性別 (男生/女生)"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGenderDefault"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_default" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGenderMale"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_male" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGenderFemale"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_female" />

        </com.google.android.material.chip.ChipGroup>

        <!-- 語調 (Pitch) 微調滑桿 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pitch"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPitchValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.00"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderPitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.6"
            android:valueTo="1.6"
            android:stepSize="0.05"
            android:value="1.0"
            app:thumbColor="@color/accent"
            app:trackColorActive="@color/accent" />

        <!-- 系統語音引擎語音選單 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🇹🇼 優先選用台灣口音 (zh-TW)"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSystemTtsSettings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="下載/設定台灣語音"
                android:textSize="11sp"
                android:textColor="@color/primary" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerVoices"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/btn_dropdown" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider" />

        <!-- 自動換下一章開關 -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoNextChapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_next_chapter"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider" />

        <!-- 細項朗讀範圍過濾 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/read_options_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchReadTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/read_chapter_title"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchReadBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/read_body"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchReadWorkRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/read_work_record"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />

        <!-- 工作記錄細項勾選 -->
        <LinearLayout
            android:id="@+id/layoutWorkRecordCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="6dp">

            <CheckBox
                android:id="@+id/cbHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_history"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <CheckBox
                android:id="@+id/cbVerification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_verification"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <CheckBox
                android:id="@+id/cbInference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_inference"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <CheckBox
                android:id="@+id/cbFiction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_fiction"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <CheckBox
                android:id="@+id/cbContinuity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_continuity"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <CheckBox
                android:id="@+id/cbTransition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_transition"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <CheckBox
                android:id="@+id/cbOther"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_other"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="完成設定"
            android:backgroundTint="@color/primary"
            android:textColor="@android:color/white"
            app:cornerRadius="24dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
